# Copiez ce fichier en « .env » sur le serveur (cp .env.example .env) puis remplissez-le.
# Le fichier .env contient des secrets : il ne doit jamais être partagé ni envoyé ailleurs.

# Adresse du site. Elle doit pointer vers votre serveur dans le DNS.
PDF_HOST=pdm.louisharicuisine.com

# Connexion : générez ces trois lignes avec  python outils/mot_de_passe.py  puis remplacez-les ici.
# Le site refuse de démarrer sans elles (il ne doit jamais être public sans mot de passe).
# Gardez les apostrophes autour de AUTH_HASH : elles protègent les signes « $ ».
AUTH_USER=identifiant
AUTH_HASH='$2y$12$remplacez_par_la_valeur_generee'
SECRET_KEY=remplacez_par_une_longue_valeur_aleatoire

# Durée pendant laquelle le site se souvient de votre connexion (en jours ; elle se prolonge à chaque visite).
SESSION_DAYS=90
